{
  "name": "nimm",
  "version": "1.0.0",
  "description": "NIMM! – Das Rosinenspiel (lokale Vanilla-HTML/CSS/JS-App, läuft per file:// ohne Build)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "coverage": "c8 --reporter=text --reporter=lcov --exclude=\"tests/**\" --check-coverage --statements 95 --branches 95 --functions 100 --lines 95 node --test \"tests/unit/*.test.js\"",
    "test": "for t in tests/*.test.js; do node \"$t\"; done",
    "test:e2e": "playwright test",
    "e2e:install-browsers": "playwright install chromium",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  }
}
